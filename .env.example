# Browser TURN credentials only. Do not put a provider API/admin key here.
# Copy to .env.local and replace with an issued provider configuration.
# Include TURN over TCP/TLS on port 443 when offered by your provider.
VITE_TURN_SERVERS='[{"urls":["turns:YOUR_RELAY_HOST:443?transport=tcp"],"username":"YOUR_TURN_USERNAME","credential":"YOUR_TURN_PASSWORD"}]'
